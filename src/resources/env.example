# relay's credentials. Copy this file to .relay/.env and fill it in.
# .relay/.env is gitignored — never commit it.
# Token permissions: https://github.com/miwurster/relay/blob/main/docs/setup.md

# A GitHub token with write access to this repo's contents, issues and pull requests.
GH_TOKEN=

# One Claude credential. CLAUDE_CODE_OAUTH_TOKEN wins if both are set.
CLAUDE_CODE_OAUTH_TOKEN=
# ANTHROPIC_API_KEY=
